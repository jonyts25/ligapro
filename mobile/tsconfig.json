{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@ligapro/database": ["../src/types/database.ts"],
      "@ligapro/shared": ["../src/lib/shared/index.ts"],
      "@ligapro/shared/*": ["../src/lib/shared/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
