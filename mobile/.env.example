# Supabase (ligapro-dev). Copia a mobile/.env — no commitear valores reales.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Next.js (borrado de cuenta y futuras APIs internas)
EXPO_PUBLIC_SITE_URL=https://ligapro-dev.up.railway.app

# Google OAuth nativo (Google Cloud Console → OAuth client IDs).
# iOS habilita el botón con IOS + WEB. Android lo habilita con ANDROID + WEB.
# El client ID de Android se agrega hasta después del primer build de EAS:
# Google Cloud lo exige con el SHA-1 del certificado de firma, que ese build genera.
# app.config.ts deriva el URL scheme de iOS (reversed client ID) desde
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID. Queda en el binario: hay que rehacer el
# build nativo si ese client ID cambia.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
